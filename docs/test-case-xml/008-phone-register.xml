<?xml version='1.0' encoding='UTF-8'?>
<task name="TC-008 手机号最小资料注册">
  <!--BASE_URL 由项目配置为 http://127.0.0.1:10201/api/v1；验证码校验须预先关闭。独立空环境，清理失败停止后续用例须由执行器实现。当前实现 communities 固定空数组时本用例 blocked。-->
  <taskStep order="10">
    <rest method="GET" path="/communities">
      <header valueType="string">
        <name>Accept</name>
        <value>application/json</value>
      </header>
      <auth mode="none"/>
      <assertionCode><![CDATA[def assert_response(responseBody, globalParam, statusCode, headers):
    if not (statusCode == 200 and isinstance(responseBody, dict) and responseBody.get("code") == 0):
        raise Blocked("社区准备请求失败")
    if not responseBody.get("data"):
        raise Blocked("没有可用社区，且无公开创建接口")
    return bool(responseBody["data"][0].get("id"))
]]></assertionCode>
      <extractParam valueType="string">
        <name>COMMUNITY_A</name>
        <value>data[0].id</value>
      </extractParam>
    </rest>
  </taskStep>
  <taskStep order="20" ifParameter="COMMUNITY_A" ifOperator="notEmpty" onFalse="blocked">
    <rest method="POST" path="/auth/register">
      <header valueType="string">
        <name>Accept</name>
        <value>application/json</value>
      </header>
      <header valueType="string">
        <name>Content-Type</name>
        <value>application/json</value>
      </header>
      <auth mode="none"/>
      <body>
        <kv>
          <key>identityType</key>
          <value>phone</value>
        </kv>
        <kv>
          <key>identityValue</key>
          <value>13900000002</value>
        </kv>
        <kv>
          <key>code</key>
          <value>246810</value>
        </kv>
        <kv>
          <key>nickname</key>
          <value>测试用户B</value>
        </kv>
        <kv>
          <key>communityId</key>
          <parameter>COMMUNITY_A</parameter>
        </kv>
      </body>
      <assertionCode><![CDATA[def assert_response(responseBody, globalParam, statusCode, headers):
    if statusCode == 409:
        raise Blocked("指定手机号已有身份，不删除已有账号")
    return (statusCode == 200 and isinstance(responseBody, dict) and responseBody.get("code") == 0 and bool(responseBody.get("data", {}).get("user", {}).get("id")) and responseBody["data"]["user"].get("communityId") == globalParam["COMMUNITY_A"] and bool(responseBody["data"].get("accessToken")) and bool(responseBody["data"].get("refreshToken")))
]]></assertionCode>
      <extractParam valueType="string">
        <name>USER_B</name>
        <value>data.user.id</value>
      </extractParam>
      <extractParam valueType="string" sensitive="true">
        <name>TOKEN_B</name>
        <value>data.accessToken</value>
      </extractParam>
      <extractParam valueType="string" sensitive="true">
        <name>REFRESH_B</name>
        <value>data.refreshToken</value>
      </extractParam>
      <extractParam valueType="string" sensitive="true">
        <name>TOKEN_ORIGINAL</name>
        <value>data.accessToken</value>
      </extractParam>
      <extractParam valueType="string" sensitive="true">
        <name>REFRESH_ORIGINAL</name>
        <value>data.refreshToken</value>
      </extractParam>
    </rest>
  </taskStep>
  <taskStep order="30" ifParameter="USER_B" ifOperator="notEmpty" onFalse="blocked">
    <rest method="GET" path="/me">
      <header valueType="string">
        <name>Accept</name>
        <value>application/json</value>
      </header>
      <auth mode="bearer" parameter="TOKEN_B"/>
      <assertionCode><![CDATA[def assert_response(responseBody, globalParam, statusCode, headers):
    return (statusCode == 200 and isinstance(responseBody, dict) and responseBody.get("code") == 0 and responseBody["data"].get("id") == globalParam["USER_B"] and responseBody["data"].get("communityId") == globalParam["COMMUNITY_A"])
]]></assertionCode>
    </rest>
  </taskStep>
  <finally>
    <taskStep order="10" ifParameter="TOKEN_B" ifOperator="notEmpty" onFalse="skip">
      <rest method="GET" path="/me">
        <header valueType="string">
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <auth mode="bearer" parameter="TOKEN_B"/>
        <assertionCode><![CDATA[def assert_response(responseBody, globalParam, statusCode, headers):
    return (statusCode == 200 and isinstance(responseBody, dict) and responseBody.get("code") == 0 and responseBody["data"].get("id") == globalParam["USER_B"]) or (statusCode == 401 and isinstance(responseBody, dict) and responseBody.get("code") == 40101)
]]></assertionCode>
        <extractParam valueType="integer">
          <name>CLEAN_PROBE_CODE</name>
          <value>code</value>
        </extractParam>
      </rest>
    </taskStep>
    <taskStep order="20" ifParameter="CLEAN_PROBE_CODE" ifOperator="equals" onFalse="skip" ifValue="40101">
      <rest method="POST" path="/auth/refresh">
        <header valueType="string">
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <header valueType="string">
          <name>Content-Type</name>
          <value>application/json</value>
        </header>
        <auth mode="none"/>
        <body>
          <kv>
            <key>refreshToken</key>
            <parameter>REFRESH_B</parameter>
          </kv>
        </body>
        <assertionCode><![CDATA[def assert_response(responseBody, globalParam, statusCode, headers):
    return (statusCode == 200 and isinstance(responseBody, dict) and responseBody.get("code") == 0 and responseBody["data"]["user"].get("id") == globalParam["USER_B"] and bool(responseBody["data"].get("accessToken")) and bool(responseBody["data"].get("refreshToken")))
]]></assertionCode>
        <extractParam valueType="string" sensitive="true">
          <name>TOKEN_REFRESHED</name>
          <value>data.accessToken</value>
        </extractParam>
        <extractParam valueType="string" sensitive="true">
          <name>REFRESH_REFRESHED</name>
          <value>data.refreshToken</value>
        </extractParam>
        <updateParam>
          <name>TOKEN_B</name>
          <value>data.accessToken</value>
        </updateParam>
        <updateParam>
          <name>REFRESH_B</name>
          <value>data.refreshToken</value>
        </updateParam>
      </rest>
    </taskStep>
    <taskStep order="30" ifParameter="USER_B" ifOperator="notEmpty" onFalse="skip">
      <rest method="DELETE" path="/me">
        <header valueType="string">
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <auth mode="bearer" parameter="TOKEN_B"/>
        <assertionCode><![CDATA[def assert_response(responseBody, globalParam, statusCode, headers):
    return (statusCode == 200 and isinstance(responseBody, dict) and responseBody.get("code") == 0 and responseBody.get("data") == {} and bool(responseBody.get("requestId")))
]]></assertionCode>
        <extractParam valueType="string">
          <name>DELETE_REQUEST_ID</name>
          <value>requestId</value>
        </extractParam>
        <extractParam valueType="integer">
          <name>DELETE_CODE</name>
          <value>code</value>
        </extractParam>
      </rest>
    </taskStep>
    <taskStep order="40" ifParameter="TOKEN_ORIGINAL" ifOperator="notEmpty" onFalse="skip">
      <rest method="GET" path="/me">
        <header valueType="string">
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <auth mode="bearer" parameter="TOKEN_ORIGINAL"/>
        <assertionCode><![CDATA[def assert_response(responseBody, globalParam, statusCode, headers):
    return statusCode == 401 and isinstance(responseBody, dict) and responseBody.get("code") == 40101 and bool(responseBody.get("requestId"))
]]></assertionCode>
        <extractParam valueType="string">
          <name>TOKEN_ORIGINAL_INVALIDATION_REQUEST_ID</name>
          <value>requestId</value>
        </extractParam>
        <extractParam valueType="integer">
          <name>TOKEN_ORIGINAL_INVALIDATION_CODE</name>
          <value>code</value>
        </extractParam>
      </rest>
    </taskStep>
    <taskStep order="50" ifParameter="REFRESH_ORIGINAL" ifOperator="notEmpty" onFalse="skip">
      <rest method="POST" path="/auth/refresh">
        <header valueType="string">
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <header valueType="string">
          <name>Content-Type</name>
          <value>application/json</value>
        </header>
        <auth mode="none"/>
        <body>
          <kv>
            <key>refreshToken</key>
            <parameter>REFRESH_ORIGINAL</parameter>
          </kv>
        </body>
        <assertionCode><![CDATA[def assert_response(responseBody, globalParam, statusCode, headers):
    return statusCode == 401 and isinstance(responseBody, dict) and responseBody.get("code") == 40101 and bool(responseBody.get("requestId"))
]]></assertionCode>
        <extractParam valueType="string">
          <name>REFRESH_ORIGINAL_INVALIDATION_REQUEST_ID</name>
          <value>requestId</value>
        </extractParam>
        <extractParam valueType="integer">
          <name>REFRESH_ORIGINAL_INVALIDATION_CODE</name>
          <value>code</value>
        </extractParam>
      </rest>
    </taskStep>
    <taskStep order="60" ifParameter="TOKEN_REFRESHED" ifOperator="notEmpty" onFalse="skip">
      <rest method="GET" path="/me">
        <header valueType="string">
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <auth mode="bearer" parameter="TOKEN_REFRESHED"/>
        <assertionCode><![CDATA[def assert_response(responseBody, globalParam, statusCode, headers):
    return statusCode == 401 and isinstance(responseBody, dict) and responseBody.get("code") == 40101 and bool(responseBody.get("requestId"))
]]></assertionCode>
        <extractParam valueType="string">
          <name>TOKEN_REFRESHED_INVALIDATION_REQUEST_ID</name>
          <value>requestId</value>
        </extractParam>
        <extractParam valueType="integer">
          <name>TOKEN_REFRESHED_INVALIDATION_CODE</name>
          <value>code</value>
        </extractParam>
      </rest>
    </taskStep>
    <taskStep order="70" ifParameter="REFRESH_REFRESHED" ifOperator="notEmpty" onFalse="skip">
      <rest method="POST" path="/auth/refresh">
        <header valueType="string">
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <header valueType="string">
          <name>Content-Type</name>
          <value>application/json</value>
        </header>
        <auth mode="none"/>
        <body>
          <kv>
            <key>refreshToken</key>
            <parameter>REFRESH_REFRESHED</parameter>
          </kv>
        </body>
        <assertionCode><![CDATA[def assert_response(responseBody, globalParam, statusCode, headers):
    return statusCode == 401 and isinstance(responseBody, dict) and responseBody.get("code") == 40101 and bool(responseBody.get("requestId"))
]]></assertionCode>
        <extractParam valueType="string">
          <name>REFRESH_REFRESHED_INVALIDATION_REQUEST_ID</name>
          <value>requestId</value>
        </extractParam>
        <extractParam valueType="integer">
          <name>REFRESH_REFRESHED_INVALIDATION_CODE</name>
