<?xml version='1.0' encoding='UTF-8'?>
<task name="TC-030 头像拒绝非受控附件地址">
  <!--附件 URL、类型和大小规则尚未确认，ATTACHMENT_RULES_CONFIRMED=false 在注册前明确阻塞。完整流程保留供规则确认后评审启用，不将社区查询记作目标通过。跨任务身份复用和清理失败停止后续任务须由执行器保证。-->
  <parameters><parameter type="fixed" valueType="boolean"><name>ATTACHMENT_RULES_CONFIRMED</name><value>false</value></parameter></parameters><taskStep order="10">
    <rest method="GET" path="/communities">
      <header>
        <name>Accept</name>
        <value>application/json</value>
      </header>
      <auth mode="none"/>
      <assertionCode>def assert_response(responseBody, globalParam, statusCode, headers):
    if statusCode != 200 or not isinstance(responseBody, dict) or responseBody.get("code") != 0:
        raise Blocked("社区准备请求失败")
    if not responseBody.get("data"):
        raise Blocked("无可用社区，公开 HTTP 没有创建接口")
    if not responseBody["data"][0].get("id"):
        raise Blocked("社区 ID 不可取得")
    return True
</assertionCode>
      <extractParam>
        <name>COMMUNITY_A</name>
        <value>data[0].id</value>
      </extractParam>
    </rest>
  </taskStep>
  <taskStep order="20" ifParameter="ATTACHMENT_RULES_CONFIRMED" onFalse="blocked" ifOperator="truthy">
    <!--源用例要求无已确认附件规则时阻塞；规则确认后须评审该 URL 的拒绝预期，再更新门禁。--><rest method="POST" path="/auth/register">
      <header>
        <name>Accept</name>
        <value>application/json</value>
      </header>
      <header>
        <name>Content-Type</name>
        <value>application/json</value>
      </header>
      <auth mode="none"/>
      <body>
        <kv>
          <key>identityType</key>
          <value>email</value>
        </kv>
        <kv>
          <key>identityValue</key>
          <value>782213745@qq.com</value>
        </kv>
        <kv>
          <key>nickname</key>
          <value>测试用户A</value>
        </kv>
        <kv>
          <key>communityId</key>
          <parameter>COMMUNITY_A</parameter>
        </kv>
        <kv>
          <key>code</key>
          <value>246810</value>
        </kv>
      </body>
      <assertionCode>def assert_response(responseBody, globalParam, statusCode, headers):
    if statusCode != 200 or not isinstance(responseBody, dict) or responseBody.get("code") != 0:
        raise Blocked("注册准备失败；不能删除来源不明的已有身份")
    data = responseBody["data"]
    assert data["user"]["id"] and data["accessToken"] and data["refreshToken"]
    return True
</assertionCode>
      <extractParam>
        <name>USER_A</name>
        <value>data.user.id</value>
      </extractParam>
      <extractParam sensitive="true">
        <name>TOKEN_A</name>
        <value>data.accessToken</value>
      </extractParam>
      <extractParam sensitive="true">
        <name>REFRESH_A</name>
        <value>data.refreshToken</value>
      </extractParam>
      <extractParam sensitive="true">
        <name>TOKEN_A_ORIGINAL</name>
        <value>data.accessToken</value>
      </extractParam>
      <extractParam sensitive="true">
        <name>REFRESH_A_ORIGINAL</name>
        <value>data.refreshToken</value>
      </extractParam>
    </rest>
  </taskStep>
  <taskStep order="30" ifParameter="TOKEN_A" onFalse="blocked">
    <rest method="GET" path="/me">
      <header>
        <name>Accept</name>
        <value>application/json</value>
      </header>
      <auth mode="bearer" parameter="TOKEN_A"/>
      <assertionCode>def assert_response(responseBody, globalParam, statusCode, headers):
    if statusCode != 200 or responseBody.get("code") != 0:
        raise Blocked("无法取得更新前完整资料")
    assert responseBody["data"]["id"] == globalParam["USER_A"]
    return True
</assertionCode>
      <extractParam valueType="object">
        <name>PROFILE_BEFORE</name>
        <value>data</value>
      </extractParam>
    </rest>
  </taskStep>
  <taskStep order="40" ifParameter="TOKEN_A" onFalse="blocked">
    <rest method="PATCH" path="/me">
      <header>
        <name>Accept</name>
        <value>application/json</value>
      </header>
      <header>
        <name>Content-Type</name>
        <value>application/json</value>
      </header>
      <auth mode="bearer" parameter="TOKEN_A"/>
      <rawBody>{"avatarUrl":"https://untrusted.invalid/avatar.exe"}</rawBody>
      <assertionCode>def assert_response(responseBody, globalParam, statusCode, headers):
    return statusCode == 400 and responseBody["code"] == 40001
</assertionCode>
    </rest>
  </taskStep>
  <taskStep order="50" ifParameter="TOKEN_A" onFalse="blocked">
    <rest method="GET" path="/me">
      <header>
        <name>Accept</name>
        <value>application/json</value>
      </header>
      <auth mode="bearer" parameter="TOKEN_A"/>
      <assertionCode>def assert_response(responseBody, globalParam, statusCode, headers):
    assert statusCode == 200 and responseBody["code"] == 0
    assert responseBody["data"] == globalParam["PROFILE_BEFORE"]
    return True
</assertionCode>
    </rest>
  </taskStep>
  <finally>
    <taskStep order="10" ifParameter="TOKEN_A">
      <rest method="GET" path="/me">
        <header>
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <auth mode="bearer" parameter="TOKEN_A"/>
        <assertionCode>def assert_response(responseBody, globalParam, statusCode, headers):
    assert responseBody.get("requestId")
    if statusCode == 200 and responseBody["code"] == 0:
        assert responseBody["data"]["id"] == globalParam["USER_A"]
        return True
    return statusCode == 401 and responseBody["code"] == 40101
</assertionCode>
        <extractParam valueType="integer">
          <name>CLEANUP_PROBE_CODE</name>
          <value>code</value>
        </extractParam>
      </rest>
    </taskStep>
    <taskStep order="20" ifParameter="CLEANUP_PROBE_CODE" ifOperator="equals" ifValue="40101">
      <rest method="POST" path="/auth/refresh">
        <header>
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <header>
          <name>Content-Type</name>
          <value>application/json</value>
        </header>
        <auth mode="none"/>
        <body>
          <kv>
            <key>refreshToken</key>
            <parameter>REFRESH_A</parameter>
          </kv>
        </body>
        <assertionCode>def assert_response(responseBody, globalParam, statusCode, headers):
    assert statusCode == 200 and responseBody["code"] == 0
    assert responseBody.get("requestId")
    assert responseBody["data"]["user"]["id"] == globalParam["USER_A"]
    assert responseBody["data"]["accessToken"] and responseBody["data"]["refreshToken"]
    return True
</assertionCode>
        <updateParam>
          <name>TOKEN_A</name>
          <value>data.accessToken</value>
        </updateParam>
        <updateParam>
          <name>REFRESH_A</name>
          <value>data.refreshToken</value>
        </updateParam>
      </rest>
    </taskStep>
    <taskStep order="30" ifParameter="TOKEN_A">
      <rest method="DELETE" path="/me">
        <header>
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <auth mode="bearer" parameter="TOKEN_A"/>
        <assertionCode>def assert_response(responseBody, globalParam, statusCode, headers):
    assert statusCode == 200 and responseBody["code"] == 0
    assert responseBody.get("requestId")
    return responseBody["data"] == {}
</assertionCode>
        <extractParam valueType="integer">
          <name>DELETE_CODE</name>
          <value>code</value>
        </extractParam>
        <extractParam>
          <name>DELETE_REQUEST_ID</name>
          <value>requestId</value>
        </extractParam>
      </rest>
    </taskStep>
    <taskStep order="40" ifParameter="TOKEN_A_ORIGINAL">
      <rest method="GET" path="/me">
        <header>
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <auth mode="bearer" parameter="TOKEN_A_ORIGINAL"/>
        <assertionCode>def assert_response(responseBody, globalParam, statusCode, headers):
    return statusCode == 401 and responseBody["code"] == 40101 and bool(responseBody.get("requestId"))
</assertionCode>
      </rest>
    </taskStep>
    <taskStep order="50" ifParameter="TOKEN_A">
      <rest method="GET" path="/me">
        <header>
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <auth mode="bearer" parameter="TOKEN_A"/>
        <assertionCode>def assert_response(responseBody, globalParam, statusCode, headers):
    return statusCode == 401 and responseBody["code"] == 40101 and bool(responseBody.get("requestId"))
</assertionCode>
      </rest>
    </taskStep>
    <taskStep order="60" ifParameter="REFRESH_A_ORIGINAL">
      <rest method="POST" path="/auth/refresh">
        <header>
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <header>
          <name>Content-Type</name>
          <value>application/json</value>
        </header>
        <auth mode="none"/>
        <body>
          <kv>
            <key>refreshToken</key>
            <parameter>REFRESH_A_ORIGINAL</parameter>
          </kv>
        </body>
        <assertionCode>def assert_response(responseBody, globalParam, statusCode, headers):
    return statusCode == 401 and responseBody["code"] == 40101 and bool(responseBody.get("requestId"))
</assertionCode>
      </rest>
    </taskStep>
    <taskStep order="70" ifParameter="REFRESH_A">
      <rest method="POST" path="/auth/refresh">
        <header>
          <name>Accept</name>
          <value>application/json</value>
        </header>
        <header>
          <name>Content-Type</name>
          <value>application/json</value>
        </header>
        <auth mode="none"/>
        <body>
          <kv>
            <key>refreshToken</key>
            <parameter>REFRESH_A</parameter>
          </kv>
        </body>
        <assertionCode>def assert_response(responseBody, globalParam, statusCode, headers):
    return statusCode == 401 and responseBody["code"] == 40101 and bool(responseBody.get("requestId"))
</assertionCode>
      </rest>
    </taskStep>
  </finally>
</task>
