<?xml version="1.0" encoding="UTF-8"?>
<database name="part-service" source="03-chat.xml" dialect="postgresql">
  <tables>
    <table name="chat_room" if-not-exists="true" comment="聊天室">
      <columns>
        <column name="id" type="uuid" nullable="true" default="gen_random_uuid()" comment="主键 ID" />
        <column name="topic_id" type="uuid" nullable="false" comment="主题 ID" />
        <column name="name" type="varchar(100)" nullable="true" comment="名称" />
        <column name="status" type="varchar(16)" nullable="false" default="'active'" comment="状态" />
        <column name="created_at" type="timestamptz(0)" nullable="false" default="now()" comment="创建时间" />
        <column name="closed_at" type="timestamptz(0)" nullable="true" comment="关闭时间" />
      </columns>
      <constraints>
        <primary-key name="pk_chat_room_id" columns="id" />
        <unique name="uq_chat_room_topic_id" columns="topic_id" />
        <!-- Keep the original topic ID after account deletion removes its topic. -->
        <check name="ck_chat_room_status" expression="status IN ('active', 'closed')" />
      </constraints>
    </table>
    <table name="chat_member" if-not-exists="true" comment="聊天室成员">
      <columns>
        <column name="room_id" type="uuid" nullable="false" comment="聊天室 ID" />
        <column name="user_id" type="uuid" nullable="false" comment="用户 ID" />
        <column name="role" type="varchar(16)" nullable="false" default="'member'" comment="成员角色" />
        <column name="joined_at" type="timestamptz(0)" nullable="false" default="now()" comment="加入时间" />
        <column name="left_at" type="timestamptz(0)" nullable="true" comment="离开时间" />
        <column name="last_read_message_id" type="uuid" nullable="true" comment="最后已读消息 ID" />
      </columns>
      <constraints>
        <foreign-key name="fk_chat_member_room_id" columns="room_id" references-table="chat_room"
          references-columns="id" on-delete="CASCADE" />
        <foreign-key name="fk_chat_member_user_id" columns="user_id" references-table="user"
          references-columns="id" />
        <check name="ck_chat_member_role" expression="role IN ('owner', 'member')" />
        <primary-key name="pk_chat_member" columns="room_id,user_id" />
      </constraints>
      <indexes>
        <index name="idx_chat_member_user_room" unique="false" method="btree" if-not-exists="true">
          <column name="user_id" order="ASC" />
          <column name="room_id" order="ASC" />
        </index>
      </indexes>
    </table>
    <table name="chat_message" if-not-exists="true" comment="聊天消息">
      <columns>
        <column name="id" type="uuid" nullable="true" default="gen_random_uuid()" comment="主键 ID" />
        <column name="room_id" type="uuid" nullable="false" comment="聊天室 ID" />
        <column name="sender_id" type="uuid" nullable="false" comment="发送者 ID" />
        <column name="client_message_id" type="varchar(64)" nullable="false" comment="客户端消息 ID" />
        <column name="message_type" type="varchar(16)" nullable="false" comment="消息类型" />
        <column name="content" type="text" nullable="true" comment="消息内容" />
        <column name="content_meta" type="jsonb" nullable="false" default="'{}'::jsonb"
          comment="消息元数据" />
        <column name="recalled_at" type="timestamptz(0)" nullable="true" comment="撤回时间" />
        <column name="created_at" type="timestamptz(0)" nullable="false" default="now()" comment="创建时间" />
      </columns>
      <constraints>
        <primary-key name="pk_chat_message_id" columns="id" />
        <foreign-key name="fk_chat_message_room_id" columns="room_id" references-table="chat_room"
          references-columns="id" on-delete="CASCADE" />
        <!-- Historical sender IDs survive account deletion. -->
        <check name="ck_chat_message_type" expression="message_type IN ('text', 'image', 'system')" />
        <check name="ck_chat_message_content_meta_object"
          expression="jsonb_typeof(content_meta) = 'object'" />
        <unique name="uq_chat_message_sender_client" columns="sender_id, client_message_id" />
      </constraints>
      <indexes>
        <index name="idx_chat_message_room_created" unique="false" method="btree"
          if-not-exists="true">
          <column name="room_id" order="ASC" />
          <column name="created_at" order="DESC" />
          <column name="id" order="DESC" />
        </index>
      </indexes>
    </table>
    <table name="chat_message_read" if-not-exists="true" comment="聊天消息已读记录">
      <columns>
        <column name="room_id" type="uuid" nullable="false" comment="聊天室 ID" />
        <column name="user_id" type="uuid" nullable="false" comment="用户 ID" />
        <column name="last_read_message_id" type="uuid" nullable="true" comment="最后已读消息 ID" />
        <column name="read_at" type="timestamptz(0)" nullable="false" default="now()" comment="阅读时间" />
      </columns>
      <constraints>
        <foreign-key name="fk_chat_message_read_room_id" columns="room_id"
          references-table="chat_room" references-columns="id" on-delete="CASCADE" />
        <foreign-key name="fk_chat_message_read_user_id" columns="user_id" references-table="user"
          references-columns="id" />
        <primary-key name="pk_chat_message_read" columns="room_id,user_id" />
      </constraints>
    </table>
  </tables>
  <statements>
    <statement id="chat-history-retain-room-topic-reference">
      <sql>ALTER TABLE chat_room DROP CONSTRAINT IF EXISTS fk_chat_room_topic_id</sql>
    </statement>
    <statement id="chat-history-retain-message-sender-reference">
      <sql>ALTER TABLE chat_message DROP CONSTRAINT IF EXISTS fk_chat_message_sender_id</sql>
    </statement>
  </statements>
</database>
