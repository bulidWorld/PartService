<?xml version="1.0" encoding="UTF-8"?>
<database name="part-service" source="05-service-state.xml" dialect="postgresql">
  <tables>
    <table name="service_state" if-not-exists="true" comment="服务状态">
      <columns>
        <column name="namespace" type="varchar(64)" nullable="false" comment="状态命名空间" />
        <column name="state_key" type="varchar(255)" nullable="false" comment="状态键" />
        <column name="state_value" type="jsonb" nullable="false" comment="状态值" />
        <column name="updated_at" type="timestamptz" nullable="false" default="now()"
          comment="最后更新时间" />
      </columns>
      <constraints>
        <primary-key name="pk_service_state" columns="namespace,state_key" />
      </constraints>
    </table>
  </tables>
</database>