<?xml version="1.0" encoding="UTF-8"?>
<database name="part-service" source="02-topic-participation.xml" dialect="postgresql">
  <tables>
    <table name="topic" if-not-exists="true" comment="主题">
      <columns>
        <column name="id" type="uuid" nullable="true" default="gen_random_uuid()" comment="主键 ID" />
        <column name="publisher_id" type="uuid" nullable="false" comment="发布者 ID" />
        <column name="community_id" type="uuid" nullable="false" comment="所属社区 ID" />
        <column name="title" type="varchar(80)" nullable="false" comment="主题标题" />
        <column name="detail" type="text" nullable="false" comment="详细内容" />
        <column name="constraint_json" type="jsonb" nullable="false" default="'{}'::jsonb"
          comment="主题匹配条件" />
        <column name="status" type="varchar(16)" nullable="false" default="'open'" comment="状态" />
        <column name="expires_at" type="timestamptz(0)" nullable="true" comment="过期时间" />
        <column name="created_at" type="timestamptz(0)" nullable="false" default="now()" comment="创建时间" />
        <column name="updated_at" type="timestamptz(0)" nullable="false" default="now()"
          comment="最后更新时间" />
      </columns>
      <constraints>
        <primary-key name="pk_topic_id" columns="id" />
        <foreign-key name="fk_topic_publisher_id" columns="publisher_id" references-table="user"
          references-columns="id" />
        <foreign-key name="fk_topic_community_id" columns="community_id"
          references-table="community" references-columns="id" />
        <check name="ck_topic_status"
          expression="status IN ('open', 'closed', 'cancelled', 'expired')" />
        <check name="ck_topic_constraint_object"
          expression="jsonb_typeof(constraint_json) = 'object'" />
      </constraints>
      <indexes>
        <index name="idx_topic_community_status_created" unique="false" method="btree"
          if-not-exists="true">
          <column name="community_id" order="ASC" />
          <column name="status" order="ASC" />
          <column name="created_at" order="DESC" />
          <column name="id" order="DESC" />
        </index>
        <index name="idx_topic_publisher_created" unique="false" method="btree" if-not-exists="true">
          <column name="publisher_id" order="ASC" />
          <column name="created_at" order="DESC" />
          <column name="id" order="DESC" />
        </index>
      </indexes>
    </table>
    <table name="topic_recipient" if-not-exists="true" comment="主题接收记录">
      <columns>
        <column name="id" type="uuid" nullable="true" default="gen_random_uuid()" comment="主键 ID" />
        <column name="topic_id" type="uuid" nullable="false" comment="主题 ID" />
        <column name="user_id" type="uuid" nullable="false" comment="用户 ID" />
        <column name="accepted_at" type="timestamptz(0)" nullable="true" comment="接受时间" />
        <column name="match_reason" type="jsonb" nullable="false" default="'{}'::jsonb"
          comment="匹配原因" />
        <column name="read_at" type="timestamptz(0)" nullable="true" comment="阅读时间" />
        <column name="created_at" type="timestamptz(0)" nullable="false" default="now()" comment="创建时间" />
      </columns>
      <constraints>
        <primary-key name="pk_topic_recipient_id" columns="id" />
        <foreign-key name="fk_topic_recipient_topic_id" columns="topic_id" references-table="topic"
          references-columns="id" on-delete="CASCADE" />
        <foreign-key name="fk_topic_recipient_user_id" columns="user_id" references-table="user"
          references-columns="id" />
        <check name="ck_topic_recipient_match_reason_object"
          expression="jsonb_typeof(match_reason) = 'object'" />
        <unique name="uq_topic_recipient_topic_user" columns="topic_id, user_id" />
      </constraints>
      <indexes>
        <index name="idx_topic_recipient_user_created" unique="false" method="btree"
          if-not-exists="true">
          <column name="user_id" order="ASC" />
          <column name="created_at" order="DESC" />
          <column name="id" order="DESC" />
        </index>
        <index name="idx_topic_recipient_unread" unique="false" method="btree" if-not-exists="true"
          where="read_at IS NULL">
          <column name="user_id" order="ASC" />
          <column name="created_at" order="DESC" />
        </index>
      </indexes>
    </table>
    <table name="topic_participant" if-not-exists="true" comment="主题参与者">
      <columns>
        <column name="topic_id" type="uuid" nullable="false" comment="主题 ID" />
        <column name="user_id" type="uuid" nullable="false" comment="用户 ID" />
        <column name="source" type="varchar(16)" nullable="false" comment="来源" />
        <column name="joined_at" type="timestamptz(0)" nullable="false" default="now()" comment="加入时间" />
        <column name="left_at" type="timestamptz(0)" nullable="true" comment="离开时间" />
      </columns>
      <constraints>
        <foreign-key name="fk_topic_participant_topic_id" columns="topic_id"
          references-table="topic" references-columns="id" on-delete="CASCADE" />
        <foreign-key name="fk_topic_participant_user_id" columns="user_id" references-table="user"
          references-columns="id" />
        <check name="ck_topic_participant_source" expression="source IN ('publisher', 'acceptance')" />
        <primary-key name="pk_topic_participant" columns="topic_id,user_id" />
      </constraints>
      <indexes>
        <index name="idx_topic_participant_user_joined" unique="false" method="btree"
          if-not-exists="true">
          <column name="user_id" order="ASC" />
          <column name="joined_at" order="DESC" />
          <column name="topic_id" order="ASC" />
        </index>
      </indexes>
    </table>
  </tables>
</database>