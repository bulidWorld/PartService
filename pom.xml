<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath />
  </parent>
  <groupId>com.partapp</groupId>
  <artifactId>part-service</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <properties>
    <java.version>25</java.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>3.5.7</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
      <version>2.2.21</version>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>0.2.6</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.9.0</version>
        <configuration>
          <generatorName>spring</generatorName>
          <output>${project.basedir}</output>
          <apiPackage>com.partapp.partservice.web.generated.api</apiPackage>
          <modelPackage>com.partapp.partservice.web.generated.model</modelPackage>
          <invokerPackage>com.partapp.partservice.web.generated</invokerPackage>
          <library>spring-boot</library>
          <generateSupportingFiles>true</generateSupportingFiles>
          <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
          <generateApiTests>false</generateApiTests>
          <generateModelTests>false</generateModelTests>
          <skipOverwrite>false</skipOverwrite>
          <configOptions>
            <useSpringBoot3>true</useSpringBoot3>
            <useJakartaEe>true</useJakartaEe>
            <delegatePattern>true</delegatePattern>
            <dateLibrary>java8</dateLibrary>
            <useTags>true</useTags>
          </configOptions>
        </configuration>
        <executions>
          <execution>
            <id>generate-rest-api-auth</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/rest-api/auth.yaml</inputSpec>
            </configuration>
          </execution>
          <execution>
            <id>generate-rest-api-users</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/rest-api/users.yaml</inputSpec>
            </configuration>
          </execution>
          <execution>
            <id>generate-rest-api-topics</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/rest-api/topics.yaml</inputSpec>
            </configuration>
          </execution>
          <execution>
            <id>generate-rest-api-invitations</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/rest-api/invitations.yaml</inputSpec>
            </configuration>
          </execution>
          <execution>
            <id>generate-rest-api-rooms</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/rest-api/rooms.yaml</inputSpec>
            </configuration>
          </execution>
          <execution>
            <id>generate-rest-api-ratings</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/rest-api/ratings.yaml</inputSpec>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
